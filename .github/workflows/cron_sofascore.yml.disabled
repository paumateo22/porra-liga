# ⚠️ DESACTIVADO A PROPÓSITO — este fichero no termina en .yml, así que
# GitHub Actions no lo ve ni lo ejecuta (ni por cron ni a mano desde la web).
# Para reactivarlo: renombra este fichero quitándole el ".disabled" del final
# (que vuelva a ser cron_sofascore.yml) y haz push.
#
name: Scraper Horario SofaScore

on:
  schedule:
    - cron: '3,23,43 * * * *'
  workflow_dispatch:

permissions:
  contents: write
  actions: write

# Mismo grupo que actualizador.yml/ingesta.yml a propósito: los tres tocan
# los mismos ficheros en el mismo runner, así que nunca deben correr a la
# vez — o el motor puede llegar a leer un config/participantes.json a medio
# escribir por otra ejecución y verlo vacío.
concurrency:
  group: actualizador-porra
  cancel-in-progress: false

jobs:
  actualizar-resultados:
    runs-on: self-hosted
    env:
      PYTHONUTF8: 1
      PYTHONIOENCODING: utf-8

    steps:
      - name: Comprobar ventana de temporada (LaLiga 2026-27)
        id: date_check
        run: |
          $TODAY = (Get-Date).ToString("yyyyMMdd")
          $START = "20260814"
          $END   = "20270601"

          if ($TODAY -ge $START -and $TODAY -le $END) {
            echo "is_active=true" >> $env:GITHUB_OUTPUT
            Write-Host "Dentro de temporada. Arrancando el extractor."
          } else {
            echo "is_active=false" >> $env:GITHUB_OUTPUT
            Write-Host "Fuera de temporada. Abortando silenciosamente."
          }

      - name: Clonar el repositorio
        if: steps.date_check.outputs.is_active == 'true'
        uses: actions/checkout@v4

      - name: Instalar librerias
        if: steps.date_check.outputs.is_active == 'true'
        run: |
          python -m pip install --upgrade pip --break-system-packages
          pip install -r requirements.txt --break-system-packages

      - name: Ejecutar Extractor SofaScore
        if: steps.date_check.outputs.is_active == 'true'
        run: python scripts/05_extractor_sofascore.py

      - name: Guardar cambios (Auto-Commit)
        if: steps.date_check.outputs.is_active == 'true'
        id: commit_step
        run: |
          git config --local user.email "github-actions[bot]@users.noreply.github.com"
          git config --local user.name "github-actions[bot]"
          git add data/resultados/realidad_oficial.json

          $changes = git status --porcelain
          if ([string]::IsNullOrWhiteSpace($changes)) {
            Write-Host "No hay cambios nuevos en los resultados."
            echo "has_changes=false" >> $env:GITHUB_OUTPUT
          } else {
            git commit -m "Auto-Update: resultados actualizados desde SofaScore"
            git push
            echo "has_changes=true" >> $env:GITHUB_OUTPUT
          }

      - name: Lanzar Actualizador Global
        if: steps.commit_step.outputs.has_changes == 'true'
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          $cabeceras = @{
            Authorization = "Bearer $env:GITHUB_TOKEN"
            Accept        = "application/vnd.github+json"
          }
          Invoke-RestMethod `
            -Uri "https://api.github.com/repos/$env:GITHUB_REPOSITORY/actions/workflows/actualizador.yml/dispatches" `
            -Method Post -Headers $cabeceras -Body (@{ ref = "main" } | ConvertTo-Json)
